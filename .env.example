# Copy to .env and fill in. Get a free key at sk-or-v1-0b42c459461c4c785b5e428be7d20963bb1d573444e6d9942521954d2a382dfbhttps://openrouter.ai/keys
OPENROUTER_API_KEY=

# "openrouter/free" auto-picks a currently available free model (recommended).
# Or pin one that ends in :free, e.g. meta-llama/llama-3.3-70b-instruct:free
# (see https://openrouter.ai/models?pricing=free for what is live).
OPENROUTER_MODEL=https://openrouter.ai/baidu/ernie-5.5-flash-preview:free

# Optional: comma-separated fallbacks. Keep them ALL ":free" so nothing is billed.
OPENROUTER_FALLBACK_MODELS=

# Optional: lets you POST /api/refresh (header X-Refresh-Token) to re-scrape live.
REFRESH_TOKEN=
